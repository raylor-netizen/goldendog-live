#!/bin/bash
set -e
echo "[goldendog-live] live chroot tweaks"

# Drop any GoldenDog apt list copied via includes (live-build manages mirrors)
rm -f /etc/apt/sources.list.d/goldendog.sources \
      /etc/apt/sources.list.d/debian.sources 2>/dev/null || true

if [ -d /etc/sudoers.d ]; then
  echo 'goldendog ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/goldendog-live
  chmod 440 /etc/sudoers.d/goldendog-live
fi
if [ -e /etc/X11/default-display-manager ]; then
  echo /usr/bin/sddm > /etc/X11/default-display-manager || true
fi
if [ -f /etc/os-release ]; then
  sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="GoldenDog Live (showcase)"/' /etc/os-release || true
fi
systemctl disable goldendog-firstboot.service 2>/dev/null || true
echo "[goldendog-live] done"
